DISCORD_BOT_TOKEN=
DISCORD_GUILD_ALLOWLIST=
DISCORD_CHANNEL_ALLOWLIST=
DISCORD_AUTHOR_ALLOWLIST=
REQUIRE_MENTION=true
DEFAULT_BOT=
BOTS_FILE=bots.yaml
CALLBACK_SECRET=
CALLBACK_BIND=127.0.0.1
CALLBACK_PORT=8787
# Callback base sent to bots. Default suits bots running on this same box.
CALLBACK_PUBLIC_URL=http://127.0.0.1:8787
# Optional: file re-read on every wake (written by scripts/tunnel.sh with --tunnel).
CALLBACK_PUBLIC_URL_FILE=
CALLBACK_RATE_PER_MINUTE=30
REPLY_TIMEOUT_S=900
DRY_RUN=false
IN_FLIGHT_PER_CHANNEL=2

# One pair per Grok Bot named in bots.yaml (Standard Webhooks signing secret, whsec_…):
GROK_BOT_LOOPS_WEBHOOK_URL=
GROK_BOT_LOOPS_WEBHOOK_SECRET=
